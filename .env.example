# Kopioi tämä tiedosto nimelle .env ja täytä arvot. .env EI kuulu versionhallintaan.

# Finnhub API -avain (ilmainen taso: https://finnhub.io/register).
# Jos tyhjä, sovellus käyttää demotilaa (esimerkkidata) Finnhubin sijaan.
FINNHUB_API_KEY=

# Inderesin julkisten yrityssivujen haku (true/false). Oletus: true.
INDERES_ENABLED=true

# Valinnaiset: tietokannan ja seurantalistan sijainti
# STOCK_EAGLE_DB=data/stock_eagle.db
# STOCK_EAGLE_WATCHLIST=config/watchlist.toml
